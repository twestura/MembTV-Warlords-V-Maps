/* African Clearing 2020 */

/* Inspired by Bedouins made by Papaya */
#HEADER_END

#const PHONL 1544

/* PH SEASONS */

#define PH_AFRICAN

#include_drs F_seasons.inc

<PLAYER_SETUP>
nomad_resources
random_placement
ai_info_map_type ARABIA 1 0 0

/* Ensure that Oystering Ships can attack. */
effect_amount SET_ATTRIBUTE OYSTERING_SHIP ATTR_GARRISON_FIREPOWER -1

/* Ensure that all lureable animals have 340 Food. */
effect_amount SET_ATTRIBUTE DLC_ELEPHANT ATTR_STORAGE_VALUE 340
effect_amount SET_ATTRIBUTE DLC_RHINO ATTR_STORAGE_VALUE 340

<LAND_GENERATION>
base_terrain DLC_DRAGONFOREST
enable_waves 0

create_player_lands {
  terrain_type LAYER_A
  base_size 12
  left_border 7
  top_border 7
  bottom_border 7
  right_border 7
  border_fuzziness 20
  zone 1
  clumping_factor 100
}

create_land { 
  terrain_type VODA
  number_of_tiles	rnd(3,4)
  land_position rnd(15,25) rnd(15,25) 
  base_size 1
}

create_land { 
  terrain_type VODA
  number_of_tiles	rnd(3,4)
  land_position rnd(35,45) rnd(15,25) 
  base_size 1
}

