<ELEVATION_GENERATION>

#define GNRELEV_HEIGHT02
#define GNRELEV_INTENSITY_I
#define GNRELEV_LAY_A

#include_drs GeneratingElevation.inc

<TERRAIN_GENERATION>
/*
 * Creates cracked terrain on top of all of the LAYER_A.
 * This technique avoids using DLC_CRACKED as the map's base terrain.
 * Even though that would avoiding needing an extra terrain replacement,
 * LAYER_A is needed for using the GeneratingElevation file.
 */
#REPEAT(8)
  create_terrain DLC_CRACKED {
    base_terrain LAYER_A
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

#REPEAT(8)
  create_terrain LAYER_A {
    base_terrain DLC_CRACKED
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain DLC_DRAGONFOREST 5
  }
#END_REPEAT

/* Primary Forest */
create_terrain WOODIES_C {
  base_terrain LAYER_A
  spacing_to_specific_terrain WATER 5
  spacing_to_specific_terrain DLC_CRACKED 2
  land_percent 6
  number_of_clumps 16
  /* set_avoid_player_start_areas */
  set_scale_by_groups
}

/* Primary Patch */
create_terrain LAYER_B {
  base_terrain LAYER_A
  number_of_clumps 16
  spacing_to_other_terrain_types 0
  land_percent 8
  set_scale_by_size
}

#REPEAT(8)
  create_terrain DLC_ROCK {
    base_terrain LAYER_B
    land_percent 100
    number_of_clumps 8192
    spacing_to_other_terrain_types 2
  }
#END_REPEAT

#REPEAT(8)
  create_terrain LAYER_A {
    base_terrain LAYER_B
    land_percent 100
    number_of_clumps 8192
    terrain_mask 1
  }
#END_REPEAT

#REPEAT(8)
  create_terrain LAYER_B {
    base_terrain DLC_ROCK
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* Secondary Patch */
create_terrain LAYER_C {
  base_terrain LAYER_A
  land_percent 2
  number_of_clumps 24
  set_scale_by_size
  terrain_mask 1
}

/* Layer E+F Patches */
create_terrain LAYER_E {
  base_terrain LAYER_A
  land_percent 2
  number_of_clumps 20
  set_scale_by_size
  terrain_mask 1
}

create_terrain LAYER_F {
  base_terrain LAYER_A
  land_percent 1
  number_of_clumps 14
  set_scale_by_size
  terrain_mask 1
}

<OBJECTS_GENERATION>
create_object_group LUREABLE {
  add_object DLC_ELEPHANT 25
  add_object DLC_RHINO 25
  add_object DLC_RHINO 25
  add_object DLC_RHINO 25
}

/* Birds */
create_object BIRDS_A {
   number_of_objects 4
   set_scaling_to_map_size
}

/* TODO placeholders by ponds for trees */

/* Shore Fish */
create_object MELKARYBA {
  number_of_objects 14400
  set_gaia_object_only
  temp_min_distance_group_placement  1
}

