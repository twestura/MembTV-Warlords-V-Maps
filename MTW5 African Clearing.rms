create_object VILLAGER {
  set_place_for_every_player
  number_of_objects 3
  number_of_groups 3
  set_loose_grouping
  avoid_forest_zone 2
  min_distance_group_placement 2
  terrain_to_place_on LAYER_A
  temp_min_distance_group_placement 28
  actor_area villager_area
  actor_area_radius 28
  avoid_actor_area villager_area
  min_distance_group_placement 6
}

create_object DLC_GOAT {
  number_of_objects 2
  number_of_groups 1024
  set_loose_grouping
  temp_min_distance_group_placement 23
  avoid_forest_zone 3
  min_distance_group_placement 3
}

create_object HUNTABLE {
  number_of_objects 3
  number_of_groups 1024
  set_loose_grouping
  temp_min_distance_group_placement 24
  avoid_forest_zone 3
  min_distance_group_placement 3
}

create_object LUREABLE {
  number_of_objects 1024
  temp_min_distance_group_placement 24
  avoid_forest_zone 3
  min_distance_group_placement 3
  max_distance_to_other_zones 2
}

create_object GOLD {
  number_of_objects 4
  number_of_groups 1024
  temp_min_distance_group_placement 21
  set_tight_grouping
  set_gaia_object_only
  avoid_forest_zone 3
  actor_area map_gold
  actor_area_radius 4
}

create_object STONE {
  number_of_objects 3
  number_of_groups 1024
  temp_min_distance_group_placement 24
  group_placement_radius 3
  set_tight_grouping
  avoid_forest_zone 3
  set_gaia_object_only
  avoid_actor_area map_gold
  actor_area map_stone
  actor_area_radius 4
}

create_object STRAGGLER {
  number_of_objects 15
  set_gaia_object_only
  set_scaling_to_map_size
  avoid_actor_area map_gold
  avoid_actor_area map_stone
  avoid_forest_zone 3
}
