  land_position rnd(55,65) rnd(35,45) 
  base_size 1
}

create_land { 
  terrain_type VODA
  number_of_tiles	rnd(3,4)
  land_position rnd(75,85) rnd(35,45) 
  base_size 1
}

create_land { 
  terrain_type VODA
  number_of_tiles	rnd(3,4)
  land_position rnd(15,25) rnd(55,65) 
  base_size 1
}

create_land { 
  terrain_type VODA
  number_of_tiles	rnd(3,4)
  land_position rnd(35,45) rnd(55,65) 
  base_size 1
}

create_land { 
  terrain_type VODA
  number_of_tiles	rnd(3,4)
  land_position rnd(55,65) rnd(55,65) 
  base_size 1
}

create_land { 
  terrain_type VODA
