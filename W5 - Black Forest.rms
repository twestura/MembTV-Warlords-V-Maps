	endif


/* Ensure that Oystering Ships can attack. */
effect_amount SET_ATTRIBUTE OYSTERING_SHIP ATTR_GARRISON_FIREPOWER -1

<LAND_GENERATION>
	base_terrain BASE_FOREST

	if KING_OT_HILL
		#define MIDDLE_LAND
	elseif CAPTURE_THE_RELIC
		#define MIDDLE_LAND
	endif

	create_land
	{
		terrain_type BASE_FOREST
		land_percent 0
		base_size 0
		land_position 50 50
		land_id 420
	}

	create_player_lands
	{
		terrain_type SPAWN_PLACEHOLDER
		land_percent 44
		base_size 14
		set_circular_base
		clumping_factor 2
		other_zone_avoidance_distance 6
	}
#BREAK
<ELEVATION_GENERATION>
	create_elevation 3
	{
		enable_balanced_elevation
		base_terrain SPAWN_PLACEHOLDER

		number_of_tiles (32 * MAPSCALE_AREA)
		number_of_clumps (4 * MAPSCALE_AREA)
	}

	create_elevation 7
	{
		enable_balanced_elevation
		base_terrain BASE_FOREST

		number_of_tiles (1024 * MAPSCALE_AREA)
		number_of_clumps (32 * MAPSCALE_AREA)
	}

