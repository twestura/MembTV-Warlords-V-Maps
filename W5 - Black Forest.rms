			actor_area_radius 2

			avoid_actor_area 1200 /* Neritic */
		}

		if DEATH_MATCH
		else
			#const PREDATOR_DISTANCE 40

			#include_drs includes/predators.inc
			#include_drs includes/riparian.inc
		endif

		if DEATH_MATCH
		else
			create_object FALLEN_TREE
			{
				number_of_objects 8
				min_distance_to_players 16
				temp_min_distance_group_placement 6
				place_on_forest_zone

				max_distance_to_other_zones 4

				actor_area 1300
				actor_area_radius 2
			}

			#include_drs includes/reeds.inc
		endif

		#define RELIC_TYPE_PLAYER
		#const RELIC_DISTANCE 24
		#const RELIC_SPACING 24
		#const RELIC_EDGE_DISTANCE 2
		#const RELIC_CAA_A 2000 /* Neutral Zone, Small */

		/* #include_drs includes/relics.inc */
		/* W5: Place 7 Relics, 3 per player, 1 in the middle. */
		create_object RELIC {
      set_place_for_every_player
      set_gaia_object_only
      generate_for_first_land_only
      require_path 0
      avoid_actor_area connection_relic_avoider
      min_distance_group_placement 1
      actor_area mid_relic
      actor_area_radius 25
		}
		
		create_object RELIC {
  		set_place_for_every_player
  		set_gaia_object_only
      avoid_other_land_zones 3
      require_path 0
      number_of_objects 3
      avoid_forest_zone 1
      max_distance_to_other_zones 2
      avoid_actor_area mid_relic
      min_distance_group_placement 2
      min_distance_to_players 25
      set_circular_placement
      temp_min_distance_group_placement 20
    }

