endif

/* Player resource to edit to activate circumnavigation. */
/* #const RESOURCE_CIRCUMNAVIGATION 203 */

/* TODO theming */
/* start_random
  percent_chance 20 AFRICAN_THEME
  percent_chance 20 ASIAN_THEME
  percent_chance 20 GRASS_THEME
  percent_chance 20 HAPPY_THEME
  percent_chance 20 JUNGLE_THEME
end_random */

#const FOREST_OAK_BUSH 20

#const BASE_FOREST FOREST
#const BASE1 DESERT
#const BASE2 DIRT

#const HERDABLE_A SHEEP
#const STRAGGLER OAKTREE

#MKCONSTS

/* Determines the number of ponds per player. */
start_random
  percent_chance 50 #define ONE_POND 
  percent_chance 50 #define TWO_PONDS
end_random

/* Chooses the positions of the player ponds. */
if ONE_POND
  start_random
    percent_chance 20 FRONT_POND 
    percent_chance 40 SIDE_POND 
    percent_chance 40 BACK_POND 
  end_random
elseif TWO_PONDS
  start_random
    percent_chance 20 FRONT_BACK 
    percent_chance 40 SIDE_SIDE
    percent_chance 40 SIDE_BACK 
  end_random
endif

/* Determines how many connections there will be. */
/* TODO */
#define ONE_CONNECTION
/* #define TWO_CONNECTIONS */
/* start_random
  percent_chance 50 #define ONE_CONNECTION
  percent_chance 50 #define TWO_CONNECTIONS 
end_random */

/* #const POND_PH_0 MED_WATER
#const POND_PH_1 DEEP_WATER
#const POND_PH_2 DLC_WATER4
#const POND_PH_3 DLC_WATER5 */

/* Locations of the player lands. */
#const T1 rnd(0,359)
#const OFFSET rnd(155,205)
#const T2 (T1 + OFFSET)
#const R 28
#const R_POND 18
#FOR($i, 1, 3)
  #TRIG(T$i)
  #const X$i (R * COS_T$i + 50)
  #const Y$i (R * SIN_T$i + 50)
  
  #const POND_T$i rnd(0,359)
  #TRIG(POND_T$i)
  #const POND_X$i (R_POND * COS_POND_T$i + X$i)
  #const POND_Y$i (R_POND * SIN_POND_T$i + Y$i)
#END_FOR

/* Locations of the connection midpoint. */
#const T_PERP (T1 + T2 / 2)
#TRIG(T_PERP)

if ONE_CONNECTION
  #const R_PERP_0 rnd(-10,10)
elseif TWO_CONNECTIONS
  #const R_PERP_0 rnd(25,35)
  #const R_PERP_1 rnd(25,35)
endif

#const X_PERP_0 (R_PERP_0 * COS_T_PERP + 50)
#const Y_PERP_0 (R_PERP_0 * SIN_T_PERP + 50)
#const X_PERP_1 (-1 * R_PERP_1 * COS_T_PERP + 50)
#const Y_PERP_1 (-1 * R_PERP_1 * SIN_T_PERP + 50)

<PLAYER_SETUP>
direct_placement
ai_info_map_type BLACK_FOREST 0 0 0
behavior_version 2

#SETPHATTR

/* effect_amount MOD _RESOURCE RESOURCE_CIRCUMNAVIGATION ATTR_SET -1 */

<LAND_GENERATION>
base_terrain BASE_FOREST
enable_waves 0

#FOR($i, 1, 3)
  create_land {
    terrain_type BASE$i
    land_position X$i Y$i
    assign_to AT_TEAM -10 0 0
    zone $i
    if ONE_CONNECTION
      other_zone_avoidance_distance 8
      clumping_factor 5
    elseif TWO_CONNECTIONS
      other_zone_avoidance_distance 12
    endif
    land_percent 22
    base_size 14
  }
  
  /* TODO pond locations */
  /* create_land {
    terrain_type MED_WATER
    number_of_tiles 0
    base_size 7
    land_position POND_X$i POND_Y$i
    zone $i
  } */
  
  /* TODO */
  if TWO_PONDS
  endif
#END_FOR

/* Map Middle */
create_land {
  terrain_type GRASS2
  land_position X_PERP_0 Y_PERP_0
  number_of_tiles 0
  base_size 1
  zone 10
  other_zone_avoidance_distance 0
  land_id 10
}

if TWO_CONNECTIONS
  create_land {
    terrain_type GRASS2
    land_position X_PERP_1 Y_PERP_1
    number_of_tiles 64
    base_size 5
    zone 11
    other_zone_avoidance_distance 0
  }
  
  /* create_land {
    terrain_type PINE_FOREST
    land_position 50 50
    number_of_tiles 0
    base_size 12
    set_circular_base
    other_zone_avoidance_distance 0
  } */
endif

<ELEVATION_GENERATION>
#FOR($i, 1, 3)
  create_elevation 2 {
    base_terrain BASE$i
    enable_balanced_elevation
    number_of_tiles 200
    number_of_clumps 5
  }
#END_FOR

create_elevation 3 {
  base_terrain BASE_FOREST
  enable_balanced_elevation
  number_of_tiles 2028
  number_of_clumps 32
}

<TERRAIN_GENERATION>
/* Pond generation. */
create_terrain WATER {
  base_terrain MED_WATER
  set_flat_terrain_only
  spacing_to_other_terrain_types 1
  number_of_tiles 50
  clumping_factor 25
}

create_terrain DEEP_WATER {
  base_terrain MED_WATER
  set_flat_terrain_only
  spacing_to_other_terrain_types 1
  spacing_to_specific_terrain WATER 16
  number_of_tiles 50
  clumping_factor 25
}

#REPEAT(8)
  create_terrain GRASS {
    base_terrain MED_WATER
    land_percent 100
    number_of_clumps 8192
  }
  create_terrain WATER {
    base_terrain DEEP_WATER
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* Make forests avoid the ponds. */
#REPEAT(8)
  create_terrain PINE_FOREST {
    base_terrain FOREST
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain WATER 5
  }
#END_REPEAT

#REPEAT(8)
  create_terrain GRASS {
    base_terrain FOREST
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

#REPEAT(8)
  create_terrain FOREST {
    base_terrain PINE_FOREST
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* Pockets */
create_terrain LEAVES {
  base_terrain FOREST
  number_of_tiles 512
  number_of_clumps 4
  spacing_to_other_terrain_types 12
}

