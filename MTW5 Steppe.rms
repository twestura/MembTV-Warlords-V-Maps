/*
 * Defeat players if the game mode is not set to random map.
 * Includes a check for the secondary game mode checkboxes.
 */
if ANTIQUITY_MODE
  #define ADMIN_RESTART
elseif RANDOM_MAP
  if REGICIDE
    #define ADMIN_RESTART
  elseif EMPIRE_WARS
    #define ADMIN_RESTART
  elseif SUDDEN_DEATH
    #define ADMIN_RESTART
  endif
else
  #define ADMIN_RESTART
endif
if TINY_MAP
else
  #define ADMIN_RESTART
endif
if DEFAULT_RESOURCES
else
  #define ADMIN_RESTART
endif
if DARK_AGE_START
else
  #define ADMIN_RESTART
endif
if TURBO_MODE
  #define ADMIN_RESTART
endif
if ADMIN_RESTART
  <PLAYER_SETUP>
  guard_state SABOTEUR AMOUNT_GOLD 0 1
endif

#const PHON 1543

/* Player Villager land properties. */
#const LAND_BORDER 36

/* Outside land coordinates. */
#const T rnd(0,359)
#const R 32
#const INCREMENT (360 / 5)
#FOR($i, 0, 5)
  #const OFFSET_$i rnd(-5,5)
  #const T$i ($i * INCREMENT + T + OFFSET_$i)
  #TRIG(T$i)
  #const X$i (R * COS_T$i + 50)
  #const Y$i (R * SIN_T$i + 50)
#END_FOR

/* Outside land properties. */
#const PH_TERRAIN_0 ROAD
#const PH_TERRAIN_1 ROAD2
#const PH_TERRAIN_2 DLC_DRYROAD
#const PH_TERRAIN_3 DLC_JUNGLEROAD
#const PH_TERRAIN_4 DLC_ROADGRAVEL

<PLAYER_SETUP>
random_placement
nomad_resources
ai_info_map_type STEPPE 1 0 0
behavior_version 2

/* Ensure that Oystering Ships can attack. */
effect_amount SET_ATTRIBUTE OYSTERING_SHIP ATTR_GARRISON_FIREPOWER -1

/* Sets Bird LoS to 0. */
effect_amount SET_ATTRIBUTE HAWK ATTR_LINE_OF_SIGHT 0

<LAND_GENERATION>
base_terrain DLC_DRYGRASS
enable_waves 0

/* Middle Land */
create_land {
  terrain_type DIRT3
  land_position 50 50
  /* number_of_tiles 4096 */
  /* set_circular_base */
  /* base_size 36 */
  top_border 24
  right_border 24
  bottom_border 24
  left_border 24
  land_id 10
  zone 10
}

/* Player Villager Lands */
create_land {
  terrain_type DIRT3
  number_of_tiles 0
  assign_to_player 1
  top_border LAND_BORDER
  right_border LAND_BORDER
  bottom_border LAND_BORDER
  left_border LAND_BORDER
  land_id 1
}

create_land {
  terrain_type DIRT3
  number_of_tiles 0
  assign_to_player 2
  top_border LAND_BORDER
  right_border LAND_BORDER
  bottom_border LAND_BORDER
  left_border LAND_BORDER
  land_id 1
}

create_land {
  terrain_type DIRT3
  number_of_tiles 0
  assign_to_player 2
  top_border LAND_BORDER
  right_border LAND_BORDER
  bottom_border LAND_BORDER
  left_border LAND_BORDER
  land_id 2
}

create_land {
  terrain_type DIRT3
  number_of_tiles 0
  assign_to_player 1
  top_border LAND_BORDER
  right_border LAND_BORDER
  bottom_border LAND_BORDER
  left_border LAND_BORDER
  land_id 2
}

create_land {
  terrain_type DIRT3
  number_of_tiles 0
  assign_to_player 1
  top_border LAND_BORDER
  right_border LAND_BORDER
  bottom_border LAND_BORDER
  left_border LAND_BORDER
  land_id 1
}

create_land {
  terrain_type DIRT3
  number_of_tiles 0
  assign_to_player 2
  top_border LAND_BORDER
  right_border LAND_BORDER
  bottom_border LAND_BORDER
  left_border LAND_BORDER
  land_id 1
}

create_land {
  terrain_type DIRT3
  number_of_tiles 0
  assign_to_player 2
  top_border LAND_BORDER
  right_border LAND_BORDER
  bottom_border LAND_BORDER
  left_border LAND_BORDER
}

/* Outside Lands */
#FOR($i, 0, 5)
  create_land {
    terrain_type PH_TERRAIN_$i
    land_position X$i Y$i
    number_of_tiles 0
    base_size 19
    set_circular_base
    land_id 20
    zone 2$i
    top_border 8
    right_border 8
    bottom_border 8
    left_border 8
  }
#END_FOR

<ELEVATION_GENERATION>
create_elevation 2 {
  base_terrain DLC_DRYGRASS
  enable_balanced_elevation
  number_of_tiles 1024
  number_of_clumps 32
}

<TERRAIN_GENERATION>
/* Remove the broken square land remnants. */
#FOR($i, 0, 5)
  #REPEAT(8)
    create_terrain DLC_BLACK {
      base_terrain PH_TERRAIN_$i
      land_percent 100
      number_of_clumps 8192
      spacing_to_other_terrain_types 1
    }
  #END_REPEAT
  #REPEAT(8)
    create_terrain DLC_DRYGRASS {
      base_terrain PH_TERRAIN_$i
      land_percent 100
      number_of_clumps 8192
      spacing_to_specific_terrain DIRT3 1
    }
  #END_REPEAT
  #REPEAT(8)
    create_terrain DIRT3 {
      base_terrain PH_TERRAIN_$i
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
  #REPEAT(8)
    create_terrain PH_TERRAIN_$i {
      base_terrain DLC_BLACK
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
#END_FOR

/* Place forest clumps around each of the circles. */
#FOR($i, 0, 5)
  #REPEAT(8)
    create_terrain DLC_BLACK {
      base_terrain PH_TERRAIN_$i
      land_percent 100
      number_of_clumps 8192
      spacing_to_other_terrain_types 7
    }
  #END_REPEAT
  create_terrain PINE_FOREST {
    base_terrain PH_TERRAIN_$i
    number_of_tiles 150
    number_of_clumps 3
    set_avoid_player_start_areas 18
  }
  #REPEAT(8)
    create_terrain DIRT2 {
      base_terrain DLC_BLACK
      land_percent 100
      number_of_clumps 8192
    }
    create_terrain DIRT2 {
      base_terrain PH_TERRAIN_$i
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
#END_FOR

/* Outside Forests */
create_terrain DLC_FORESTAUTUMN {
  base_terrain DLC_DRYGRASS
  spacing_to_specific_terrain DIRT3 8
  spacing_to_specific_terrain PINE_FOREST 5
  spacing_to_other_terrain_types 2
  number_of_tiles 1600
  number_of_clumps 64
  clumping_factor 25
}

/* Forest Masking */
create_terrain SNOW_FOREST {
  base_terrain PINE_FOREST
  number_of_tiles 256
  number_of_clumps 256
}

create_terrain DLC_FORESTSNOWAUTUMN {
  base_terrain DLC_FORESTAUTUMN
  number_of_tiles 512
  number_of_clumps 512
}

/* Terrain Masking */
/* Middle Masking */
#REPEAT(8)
  create_terrain DIRT {
    base_terrain DIRT3
    land_percent 100
    number_of_clumps 8192
    spacing_to_other_terrain_types 2
  }
#END_REPEAT

#REPEAT(8)
  create_terrain DIRT {
    base_terrain DIRT3
    land_percent 100
    number_of_clumps 8192
    terrain_mask 1
  }
#END_REPEAT

create_terrain DIRT3 {
  base_terrain DIRT
  number_of_tiles 512
  number_of_clumps 16
  terrain_mask 1
}

create_terrain SNOW {
  base_terrain DIRT
  number_of_tiles 64
  number_of_clumps 6
  terrain_mask 1
}

/* Outer Land Masking */
#REPEAT(8)
  create_terrain DLC_BLACK {
    base_terrain DIRT2
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain DIRT 3
    spacing_to_specific_terrain DIRT3 3
    spacing_to_specific_terrain DLC_DRYGRASS 3
  }
#END_REPEAT

create_terrain DLC_DRYGRASS {
  base_terrain DIRT2
  number_of_tiles 512
  number_of_clumps 16
  spacing_to_specific_terrain DIRT 3
  spacing_to_specific_terrain DIRT3 3
}

create_terrain DIRT3 {
  base_terrain DIRT2
  land_percent 100
  number_of_clumps 8192
  terrain_mask 2
}

#REPEAT(8)
  create_terrain DIRT2 {
    base_terrain DLC_BLACK
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

create_terrain SNOW {
  base_terrain DIRT2
  number_of_tiles 128
  number_of_clumps 8
  terrain_mask 1
}

create_terrain DIRT3 {
  base_terrain DIRT2
  number_of_tiles 128
  number_of_clumps 8
  terrain_mask 1
}

/* Outside Masking */
#REPEAT(8)
  create_terrain DLC_BLACK {
    base_terrain DLC_DRYGRASS
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain DIRT 3
    spacing_to_specific_terrain DIRT2 3
    spacing_to_specific_terrain DIRT3 3
  }
#END_REPEAT

#REPEAT(8)
  create_terrain DIRT3 {
    base_terrain DLC_DRYGRASS
    land_percent 100
    number_of_clumps 8192
    terrain_mask 2
  }
#END_REPEAT

#REPEAT(8)
  create_terrain DLC_DRYGRASS {
    base_terrain DLC_BLACK
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

create_terrain LEAVES {
  base_terrain DLC_DRYGRASS
  number_of_tiles 1024
  number_of_clumps 16
  terrain_mask 1
}

create_terrain SNOW {
  base_terrain DLC_DRYGRASS
  number_of_tiles 256
  number_of_clumps 16
  terrain_mask 1
}

create_terrain GRASS3 {
  base_terrain DLC_DRYGRASS
  number_of_tiles 256
  number_of_clumps 16
  terrain_mask 1
}

<OBJECTS_GENERATION>
create_actor_area 59 59 mid_avoider 40
create_actor_area 59 60 mid_avoider 40
create_actor_area 60 59 mid_avoider 40
create_actor_area 60 60 mid_avoider 40

/* Birds */
create_object HAWK {
  number_of_objects 7
}

/* Placeholders */
create_object PHON {
  number_of_objects 14400
  place_on_specific_land_id 20
  set_circular_placement
  max_distance_to_players 24
  actor_area outside_circle
  actor_area_radius 0
}

