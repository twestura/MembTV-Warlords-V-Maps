  #const BORDER_FOREST FOREST_OAK_BUSH
  #const BASE1 ROAD
  #const BASE2 ROAD2
  #const BASE_TERRAIN GRASS
  #const MIDDLE_PLACEHOLDER GRASS2
  #const POCKET_TERRAIN UNDERBRUSH_LEAVES
  #const POCKET_MASK GRASS3
  #const CONNECTION_TERRAIN UNDERBRUSH_LEAVES
  #const PATCH_TERRAIN LEAVES
  #const MASK1 GRASS2
  #const MASK2 DLC_DRYGRASS
  #const MASK3 MUD
  #const BEACH_TERRAIN DLC_BEACH3

  #const BERRIES FORAGE
  #const HERDABLE_A DLC_PIG
  #const HERDABLE_B SHEEP
  #const STRAGGLER PEACH_BLOSSOM_TREE
  #const HUNT DLC_IBEX
  #const LURE BOAR
  #const LURE_FAR BOAR
elseif GRASS_THEME
