/*
 * Defeat players if the game mode is not set to random map.
 * Includes a check for the secondary game mode checkboxes.
 */
if ANTIQUITY_MODE
  #define ADMIN_RESTART
elseif RANDOM_MAP
  if REGICIDE
    #define ADMIN_RESTART
  elseif EMPIRE_WARS
    #define ADMIN_RESTART
  elseif SUDDEN_DEATH
    #define ADMIN_RESTART
  endif
else
  #define ADMIN_RESTART
endif
if TINY_MAP
else
  #define ADMIN_RESTART
endif
if DEFAULT_RESOURCES
else
  #define ADMIN_RESTART
endif
if DARK_AGE_START
else
  #define ADMIN_RESTART
endif
if TURBO_MODE
  #define ADMIN_RESTART
endif
if ADMIN_RESTART
  <PLAYER_SETUP>
  guard_state SABOTEUR AMOUNT_GOLD 0 1
endif

/* Player resource to edit to activate circumnavigation. */
#const RESOURCE_CIRCUMNAVIGATION 203

/* Theming */
start_random
  percent_chance 10 #define AFRICAN_THEME
  percent_chance 30 #define AUTUMN_THEME
  percent_chance 40 #define GRASS_THEME
  percent_chance 20 #define SNOW_THEME
end_random

#const FOREST_OAK_BUSH 20
#const UNDERBRUSH_LEAVES 71
#const UNDERBRUSH_SNOW 72
#const SNOW_LIGHT 73
#const SNOW_STRONG 74
#const MUD 76
#const BUSH_A 302
#const FALLEN_LEAVES_AUTUMN 2031

if AFRICAN_THEME
  #const BASE_FOREST DLC_DRAGONFOREST
  #const SECONDARY_FOREST PALM_DESERT
  #const BORDER_FOREST FOREST_OAK_BUSH
  #const BASE1 ROAD
  #const BASE2 ROAD2
  #const BASE_TERRAIN DLC_SAVANNAH
  #const MIDDLE_PLACEHOLDER GRASS2
  #const POCKET_TERRAIN DLC_DIRT4
  #const POCKET_MASK DLC_SAVANNAH
  #const CONNECTION_TERRAIN DLC_DIRT4
  #const PATCH_TERRAIN DLC_DIRT4
  #const MASK1 DIRT3
  #const MASK2 GRASS3
  #const MASK3 DESERT
  #const BEACH_TERRAIN BEACH

  #const BERRIES DLC_ORANGEBUSH
  #const HERDABLE_A DLC_GOAT
  #const HERDABLE_B DLC_GOAT
  #const STRAGGLER PALMTREE
  #const HUNT GAZELLE
  #const LURE DLC_ELEPHANT
  #const LURE_FAR DLC_RHINO
elseif AUTUMN_THEME
