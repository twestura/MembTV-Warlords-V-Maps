/* Theme-specific masking. */
if AFRICAN_THEME
  #REPEAT(8)
    create_terrain BASE_FOREST {
      base_terrain SECONDARY_FOREST
      land_percent 100
      number_of_clumps 8192
    }
    create_terrain DLC_DIRT4 {
      base_terrain BORDER_FOREST
      land_percent 100
      number_of_clumps 8192
      terrain_mask 1
    }
  #END_REPEAT
  create_terrain BORDER_FOREST {
    base_terrain BASE_FOREST
    number_of_tiles 512
    number_of_clumps 64
  }
elseif AUTUMN_THEME
  #REPEAT(8)
    create_terrain BASE_FOREST {
      base_terrain SECONDARY_FOREST
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
  create_terrain BORDER_FOREST {
    base_terrain BASE_FOREST
    number_of_tiles 512
    number_of_clumps 64
  }
endif

<CONNECTION_GENERATION>
accumulate_connections
#FOR($i, 1, 3)
  create_connect_land_zones $i 10 {
    replace_terrain BASE_FOREST CONNECTION_TERRAIN
    replace_terrain SECONDARY_FOREST CONNECTION_TERRAIN
    replace_terrain BORDER_FOREST CONNECTION_TERRAIN
    replace_terrain MIDDLE_PLACEHOLDER CONNECTION_TERRAIN
    replace_terrain BEACH_TERRAIN BEACH_TERRAIN

    terrain_cost BASE_TERRAIN 1
    terrain_cost BASE_FOREST 2
    terrain_cost SECONDARY_FOREST 2
    terrain_cost BORDER_FOREST 2
    terrain_cost MIDDLE_PLACEHOLDER 1
    terrain_cost POCKET_TERRAIN 2
    terrain_cost CONNECTION_TERRAIN 2
    terrain_cost PATCH_TERRAIN 2

    terrain_size BASE_TERRAIN 5 1
    terrain_size BASE_FOREST 5 1
    terrain_size SECONDARY_FOREST 5 1
    terrain_size BORDER_FOREST 5 1
    terrain_size POCKET_TERRAIN 5 1
    terrain_size CONNECTION_TERRAIN 5 1
    terrain_size PATCH_TERRAIN 5 1
  }
#END_FOR

