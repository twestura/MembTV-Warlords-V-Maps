  land_percent 100
  number_of_clumps 8192
  terrain_mask 1
  spacing_to_other_terrain_types 1
}

/* Creates a patch of actual terrain, surrounded by a mask. */
create_terrain DLC_BLACK {
  base_terrain BASE_TERRAIN
