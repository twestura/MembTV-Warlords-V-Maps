  #const SECONDARY_FOREST PINE_FOREST
  #const BORDER_FOREST FOREST_OAK_BUSH
  #const BASE1 ROAD
  #const BASE2 ROAD2
  #const BASE_TERRAIN GRASS
  #const MIDDLE_PLACEHOLDER GRASS2
  #const POCKET_TERRAIN LEAVES
  #const POCKET_MASK GRASS3
  #const CONNECTION_TERRAIN LEAVES
  #const PATCH_TERRAIN LEAVES
  #const MASK1 DIRT3
  #const MASK2 GRASS3
  #const MASK3 LEAVES
  #const BEACH_TERRAIN BEACH

  #const BERRIES FORAGE
  #const HERDABLE_A SHEEP
  #const HERDABLE_B SHEEP
  #const STRAGGLER OAKTREE
  #const HUNT DEER
  #const LURE BOAR
  #const LURE_FAR BOAR
elseif SNOW_THEME
