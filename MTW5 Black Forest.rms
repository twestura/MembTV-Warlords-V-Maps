#const PHON 1543
#const PHONL 1544

#MKCONSTS

/* Determines the number of ponds per player. */
#define ONE_POND

/* Chooses the positions of the player ponds. */
/* #define FRONT_POND */
/* #define SIDE_POND */
/* #define BACK_POND */
start_random
  percent_chance 60 #define FRONT_POND 
  percent_chance 40 #define SIDE_POND 
end_random

/* Locations of the player lands. */
#const T1 rnd(0,359)
#const OFFSET rnd(155,205)
#const T2 (T1 + OFFSET)
#const R 28
#const R_POND 18
#FOR($i, 1, 3)
  #TRIG(T$i)
  #const X$i (R * COS_T$i + 50)
  #const Y$i (R * SIN_T$i + 50)

  start_random
    percent_chance 50 #define FLIP_POND$i
  end_random
  if FRONT_POND
    #const POND_OFFSET$i rnd(100,110)
  elseif SIDE_POND
    #const POND_OFFSET$i rnd(65,100)
  elseif BACK_POND
    #const POND_OFFSET$i rnd(0,65)
  else
    #const POND_OFFSET$i rnd(0,359)
  endif
  if FLIP_POND$i
    #const POND_T$i (POND_OFFSET$i * -1 + T$i)
  elseif
    #const POND_T$i (POND_OFFSET$i + T$i)
  endif
  #TRIG(POND_T$i)
  #const POND_X$i (R_POND * COS_POND_T$i + X$i)
  #const POND_Y$i (R_POND * SIN_POND_T$i + Y$i)
#END_FOR

/* Locations of the connection midpoint. */
#const T_PERP (T1 + T2 / 2)
#TRIG(T_PERP)

#const R_PERP_0 rnd(-10,10)

#const X_PERP_0 (R_PERP_0 * COS_T_PERP + 50)
#const Y_PERP_0 (R_PERP_0 * SIN_T_PERP + 50)

<PLAYER_SETUP>
direct_placement
ai_info_map_type BLACK_FOREST 0 0 0
behavior_version 2

#SETPHATTR

/* Sets Bird LoS to 0. */
effect_amount SET_ATTRIBUTE HAWK ATTR_LINE_OF_SIGHT 0

/* Make scenic autumn leaves avoid the water. */
effect_amount GAIA_SET_ATTRIBUTE FALLEN_LEAVES_AUTUMN ATTR_TERRAIN_ID 4

/* There is a bug with the in-game grid affecting this setting, so it remains off for now. */
/* effect_amount MOD _RESOURCE RESOURCE_CIRCUMNAVIGATION ATTR_SET -1 */

/* Upgrades trees based on the theme. */
if AFRICAN_THEME
  effect_amount GAIA_UPGRADE_UNIT OAKTREE DLC_DEADTREE 0
  effect_amount GAIA_UPGRADE_UNIT BUSH_A DLC_AFRICANBUSH 0
elseif AUTUMN_THEME
  effect_amount GAIA_UPGRADE_UNIT CYPRESS_TREE ASIAN_MAPLE_AUTUMN_TREE 0
  effect_amount GAIA_UPGRADE_UNIT ITALIAN_PINETREE PINETREE 0
  effect_amount GAIA_UPGRADE_UNIT OLIVE_TREE DLC_AUTUMNTREE 0
  effect_amount GAIA_UPGRADE_UNIT BUSH_A DLC_AFRICANBUSH 0
elseif GRASS_THEME
elseif SNOW_THEME
endif

<LAND_GENERATION>
base_terrain BASE_FOREST
enable_waves 0

#FOR($i, 1, 3)
  create_land {
    terrain_type BASE$i
    land_position X$i Y$i
    assign_to AT_TEAM -10 0 0
    zone $i
    other_zone_avoidance_distance 8
    clumping_factor 5
    land_percent 22
    base_size 14
  }

  /* Pond */
  create_land {
    terrain_type MED_WATER
    zone $i
    land_position POND_X$i POND_Y$i
    number_of_tiles 0
    base_size 5
  }
#END_FOR

/* Map Middle */
create_land {
  terrain_type MIDDLE_PLACEHOLDER
  land_position X_PERP_0 Y_PERP_0
  number_of_tiles 0
  base_size 1
  zone 10
  other_zone_avoidance_distance 0
  land_id 10
}

<ELEVATION_GENERATION>
#FOR($i, 1, 3)
  create_elevation 2 {
    base_terrain BASE$i
    enable_balanced_elevation
    number_of_tiles 200
    number_of_clumps 5
  }
#END_FOR

create_elevation 2 {
  base_terrain BASE_FOREST
  enable_balanced_elevation
  number_of_tiles 2028
  number_of_clumps 32
}

<TERRAIN_GENERATION>
/* Pond generation. */
create_terrain WATER {
  base_terrain MED_WATER
  set_flat_terrain_only
  spacing_to_other_terrain_types 1
  number_of_tiles 50
  clumping_factor 25
}

create_terrain DEEP_WATER {
  base_terrain MED_WATER
  set_flat_terrain_only
  spacing_to_other_terrain_types 1
  spacing_to_specific_terrain WATER 16
  number_of_tiles 50
  clumping_factor 25
}

#REPEAT(8)
  create_terrain BASE_TERRAIN {
    base_terrain MED_WATER
    land_percent 100
    number_of_clumps 8192
    beach_terrain BEACH_TERRAIN
  }
  create_terrain WATER {
    base_terrain DEEP_WATER
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* Make forests avoid the ponds. */
#REPEAT(8)
  create_terrain SECONDARY_FOREST {
    base_terrain BASE_FOREST
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain WATER 5
  }
#END_REPEAT

#REPEAT(8)
  create_terrain BASE_TERRAIN {
    base_terrain BASE_FOREST
    land_percent 100
    number_of_clumps 8192
    beach_terrain BEACH_TERRAIN
  }
#END_REPEAT

#REPEAT(8)
  create_terrain BASE_FOREST {
    base_terrain SECONDARY_FOREST
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* Pockets */
create_terrain POCKET_TERRAIN {
  base_terrain BASE_FOREST
  number_of_tiles 512
  number_of_clumps 4
  spacing_to_other_terrain_types 12
}

/* Covers the placeholder terrain. */
#REPEAT(8)
  #FOR($i, 1, 3)
    create_terrain BASE_TERRAIN {
      base_terrain BASE$i
      land_percent 100
      number_of_clumps 8192
      beach_terrain BEACH_TERRAIN
    }
  #END_FOR
#END_REPEAT

