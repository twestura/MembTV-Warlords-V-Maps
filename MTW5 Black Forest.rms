}

create_terrain GRASS3 {
  base_terrain GRASS
  land_percent 12
  number_of_clumps 16
  terrain_mask 1
}

create_terrain LEAVES {
  base_terrain GRASS
  land_percent 4
  number_of_clumps 16
  terrain_mask 1
}

<CONNECTION_GENERATION>
accumulate_connections
#FOR($i, 1, 3)
  create_connect_land_zones $i 10 {
    replace_terrain FOREST LEAVES
    replace_terrain PINE_FOREST LEAVES
    replace_terrain FOREST_OAK_BUSH LEAVES
    replace_terrain GRASS2 LEAVES

    terrain_cost BASE$i 1
    terrain_cost FOREST 2
    terrain_cost PINE_FOREST 2
    terrain_cost FOREST_OAK_BUSH 2
    terrain_cost GRASS 2
    terrain_cost GRASS2 1

    if ONE_CONNECTION
      terrain_size BASE$i 5 1
      terrain_size GRASS 5 1
      terrain_size LEAVES 5 1
      terrain_size FOREST 5 1
      terrain_size PINE_FOREST 5 1
      terrain_size FOREST_OAK_BUSH 5 1
    elseif TWO_CONNECTIONS
      terrain_size BASE$i 4 0
      terrain_size GRASS 4 0
      terrain_size LEAVES 4 0
      terrain_size FOREST 4 0
      terrain_size PINE_FOREST 4 0
      terrain_size FOREST_OAK_BUSH 4 0
    endif
  }
#END_FOR

