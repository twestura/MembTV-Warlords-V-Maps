#HEADER_START
/*
 * Immersion for Warlords V, edited by T-West April 2026.
 * Based on the map by TheMadCADer for Warlords IV.
 * Edited to remove the pond in the middle of the map..
 */

/* African Clearing 2020 */

/* Inspired by Bedouins made by Papaya */

/* Immersion (3-9-23) by TheMadCADer */
/* Changes from 1.1: more pools in 1v1, better resource placement */
/* Changes from 1.2: more variation in 1v1, wood farther from players */
#HEADER_END

/*
 * Defeat players if the game mode is not set to random map.
 * Includes a check for the secondary game mode checkboxes.
 */
if ANTIQUITY_MODE
  #define ADMIN_RESTART
elseif RANDOM_MAP
  if REGICIDE
    #define ADMIN_RESTART
  elseif EMPIRE_WARS
    #define ADMIN_RESTART
  elseif SUDDEN_DEATH
    #define ADMIN_RESTART
  endif
else
  #define ADMIN_RESTART
endif
if TINY_MAP
else
  #define ADMIN_RESTART
endif
if DEFAULT_RESOURCES
else
  #define ADMIN_RESTART
endif
if DARK_AGE_START
else
  #define ADMIN_RESTART
endif
if TURBO_MODE
  #define ADMIN_RESTART
endif
if ADMIN_RESTART
  <PLAYER_SETUP>
  guard_state SABOTEUR AMOUNT_GOLD 0 1
endif

#const PLANT_WEEDS 1364
#const PLANT_DEAD 1365
#const PHON 1543

#const HERDABLE_A TURKEY
#const STRAGGLER PALMTREE

/* Placeholder Terrains for setting up per-player forests. */
#const PH_P1 ROAD
#const PH_P2 ROAD2

#MKCONSTS

start_random
	percent_chance 50 #define ANGLE1
	percent_chance 50 #define ANGLE2
end_random

<PLAYER_SETUP>
random_placement

#SETPHATTR

/* Ensure that Oystering Ships can attack. */
effect_amount SET_ATTRIBUTE OYSTERING_SHIP ATTR_GARRISON_FIREPOWER -1

/* Ensure that all lureable animals have 340 Food. */
effect_amount SET_ATTRIBUTE DLC_RHINO ATTR_STORAGE_VALUE 340

/* Sets Bird LoS to 0. */
effect_amount SET_ATTRIBUTE MACAW ATTR_LINE_OF_SIGHT 0

<LAND_GENERATION>
base_terrain DIRT

#REPEAT(3)
  create_land {
    terrain_type DLC_CRACKED
    land_id 1
    top_border 44
    right_border 44
    bottom_border 44
    left_border 44
  }
#END_REPEAT

create_land { assign_to_player 1 terrain_type DLC_NEWSHALLOW land_percent 0 zone 1 base_size 11 land_id 1 circle_radius 29 0 }
create_land { assign_to_player 1 terrain_type GRASS land_percent 100 zone 1 base_size 11 top_border 7 bottom_border 7 right_border 7 left_border 7 border_fuzziness 12 }
create_land { assign_to_player 1 terrain_type DLC_NEWSHALLOW land_percent 0 zone 1 base_size 11 land_id 1 }
create_land { assign_to_player 2 if ANGLE1 terrain_type GRASS land_percent 100 zone 1 base_size 11 top_border 7 bottom_border 7 right_border 7 left_border 7 border_fuzziness 12 else terrain_type DLC_NEWSHALLOW land_percent 0 zone 1 base_size 11 land_id 1 endif }
create_land { assign_to_player 2 if ANGLE2 terrain_type GRASS land_percent 100 zone 1 base_size 11 top_border 7 bottom_border 7 right_border 7 left_border 7 border_fuzziness 12 else terrain_type DLC_NEWSHALLOW land_percent 0 zone 1 base_size 11 land_id 1 endif }

<ELEVATION_GENERATION>
create_elevation 1 {
  base_terrain GRASS
  enable_balanced_elevation
  number_of_tiles 625
  number_of_clumps 12
  set_scale_by_size
}

<TERRAIN_GENERATION>
#REPEAT(8)
  create_terrain DESERT {
    base_terrain GRASS
    land_percent 100
    number_of_clumps 8192
    set_avoid_player_start_areas
  }
#END_REPEAT

#REPEAT(8)
  create_terrain DESERT {
    base_terrain DLC_NEWSHALLOW
    land_percent 100
    number_of_clumps 8192
    set_avoid_player_start_areas
  }
#END_REPEAT

#REPEAT(8)
  create_terrain DLC_NEWSHALLOW {
    base_terrain DIRT
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain DLC_CRACKED 11
  }
#END_REPEAT

/* Fill the middle with cracked terrain. */
#REPEAT(8)
  create_terrain DLC_CRACKED {
    base_terrain DIRT
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* Fill the Shallows with water. */
#REPEAT(8)
  create_terrain DLC_WATER5 {
    base_terrain DLC_NEWSHALLOW
    land_percent 100
    number_of_clumps 8192
    spacing_to_other_terrain_types 2
  }
#END_REPEAT

/* Middle Pond: Mask Shallows. */
create_terrain SHALLOW {
  base_terrain DLC_CRACKED
  number_of_tiles 36
  number_of_clumps 4
  spacing_to_specific_terrain DESERT 3
  terrain_mask 1
}

create_terrain DLC_NEWSHALLOW {
  base_terrain DLC_CRACKED
  land_percent 100
  number_of_clumps 8192
  spacing_to_specific_terrain DESERT 2
  terrain_mask 1
}

create_terrain DLC_NEWSHALLOW {
  base_terrain DLC_CRACKED
  number_of_tiles 8
  number_of_clumps 8
  spacing_to_specific_terrain DESERT 1
  terrain_mask 1
}

create_terrain DIRT3 {
  base_terrain DLC_CRACKED
  number_of_tiles 32
  number_of_clumps 8
  terrain_mask 1
}

/* Forest Generation */
/* Covers one player land with a placeholder terrain. */
create_terrain PH_P1 {
  base_terrain GRASS
  land_percent 100
  spacing_to_other_terrain_types 4
}

#REPEAT(8)
  create_terrain PH_P2 {
    base_terrain GRASS
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain PH_P1 8
    spacing_to_other_terrain_types 3
  }
#END_REPEAT

#REPEAT(8)
  create_terrain PH_P1 {
    base_terrain GRASS
    land_percent 100
    number_of_clumps 8192
    spacing_to_other_terrain_types 3
  }
#END_REPEAT

#REPEAT(8)
  create_terrain DESERT {
    base_terrain GRASS
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* At this point, both player lands have different terrains. */
/* Place forests near the player lands. */
#FOR($i, 1, 3)
  #REPEAT(8)
    create_terrain DLC_BLACK {
      base_terrain DESERT
      land_percent 100
      number_of_clumps 8192
      spacing_to_specific_terrain PH_P$i 16
    }
  #END_REPEAT
  
  /* There now is a ring of desert around the first player land. */
  /* First Player Forest */
  #REPEAT(3)
    create_terrain SNOW {
      base_terrain DESERT
      spacing_to_other_terrain_types 5
      spacing_to_specific_terrain PALM_DESERT 12
      number_of_tiles 1
    }
    
    #REPEAT(8)
      create_terrain DLC_DRYROAD {
        base_terrain DESERT
        land_percent 100
        number_of_clumps 8192
        spacing_to_specific_terrain SNOW 6
      }
    #END_REPEAT
    
    #REPEAT(8)
      create_terrain DESERT {
        base_terrain SNOW
        land_percent 100
        number_of_clumps 8192
      }
    #END_REPEAT
    
    create_terrain PALM_DESERT {
      base_terrain DESERT
      number_of_tiles 65
      set_avoid_player_start_areas
    }
    
    #REPEAT(8)
      create_terrain DESERT {
        base_terrain DLC_DRYROAD
        land_percent 100
        number_of_clumps 8192
      }
    #END_REPEAT
  #END_REPEAT
  
  #REPEAT(8)
    create_terrain DESERT {
      base_terrain DLC_BLACK
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
#END_FOR

/* Global Forests */
/* Creates a placeholder terrain avoiding the players and their forests. */
#REPEAT(8)
  create_terrain DLC_BLACK {
    base_terrain DESERT
    land_percent 100
    number_of_clumps 8192
    spacing_to_other_terrain_types 2
    spacing_to_specific_terrain PALM_DESERT 10
    spacing_to_specific_terrain PH_P1 16
    spacing_to_specific_terrain PH_P2 16
  }
#END_REPEAT

/* Repeatedly places Global Forests */
#REPEAT(12)
  create_terrain SNOW {
    base_terrain DLC_BLACK
    number_of_tiles 1
    spacing_to_other_terrain_types 3
    spacing_to_specific_terrain PALM_DESERT 12
  }
  
  #REPEAT(8)
    create_terrain DLC_DRYROAD {
      base_terrain DLC_BLACK
      land_percent 100
      number_of_clumps 8192
      spacing_to_specific_terrain SNOW 8
    }
  #END_REPEAT
  
  #REPEAT(8)
    create_terrain DLC_BLACK {
      base_terrain SNOW
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
  
  create_terrain PALM_DESERT {
    base_terrain DLC_BLACK
    number_of_tiles 70
    clumping_factor 25
  }
  
  #REPEAT(8)
    create_terrain DLC_BLACK {
      base_terrain DLC_DRYROAD
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
#END_REPEAT

#REPEAT(3)
  create_terrain SNOW {
    base_terrain DLC_BLACK
    number_of_tiles 1
    spacing_to_other_terrain_types 3
    spacing_to_specific_terrain PALM_DESERT 10
  }
  
  #REPEAT(8)
    create_terrain DLC_DRYROAD {
      base_terrain DLC_BLACK
      land_percent 100
      number_of_clumps 8192
      spacing_to_specific_terrain SNOW 6
    }
  #END_REPEAT
  
  #REPEAT(8)
    create_terrain DLC_BLACK {
      base_terrain SNOW
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
  
  create_terrain PALM_DESERT {
    base_terrain DLC_BLACK
    number_of_tiles 70
    clumping_factor 25
  }
  
  #REPEAT(8)
    create_terrain DLC_BLACK {
      base_terrain DLC_DRYROAD
      land_percent 100
      number_of_clumps 8192
    }
  #END_REPEAT
#END_REPEAT

/* Replaces the placeholder terrains with desert. */
#REPEAT(8)
  create_terrain DESERT {
    base_terrain DLC_BLACK
    land_percent 100
    number_of_clumps 8192
  }
  #FOR($i, 1, 3)
    create_terrain DESERT {
      base_terrain PH_P$i
      land_percent 100
      number_of_clumps 8192
    }
  #END_FOR
#END_REPEAT

/* Createa 1 tile around the outside of forests, adds trees, and fixes the placeholder. */
#REPEAT(8)
  create_terrain DLC_BLACK {
    base_terrain DESERT
    land_percent 100
    number_of_clumps 8192
    spacing_to_specific_terrain PALM_DESERT 1
  }
#END_REPEAT

create_terrain PALM_DESERT {
  base_terrain DESERT
  number_of_tiles 128
  number_of_clumps 128
  spacing_to_specific_terrain DLC_NEWSHALLOW 2
  spacing_to_specific_terrain DLC_WATER5 2
}

#REPEAT(8)
  create_terrain DESERT {
    base_terrain DLC_BLACK
    land_percent 100
    number_of_clumps 8192
  }
#END_REPEAT

/* Water Mixing */
